# Print numbers 1 to 10 using range()
for i in range(1, 11):
    print(i)

print()  # line break

# Print only even numbers from 2 to 20
for i in range(2, 21, 2):
    print(i)

print()  # line break

# Print items in a list with their index
items = ["apple", "banana", "cherry"]

for index, item in enumerate(items):
    print(index, item)

#PART B:
# Count down from 10 to 1, then print 'Blast off!'
count = 10
while count >= 1:
    print(count)
    count -= 1

print("Blast off!")

print()  # line break

# Guessing game
secret_number = 7
guess = 0

while guess != secret_number:
    guess = int(input("Guess the number: "))
    if guess != secret_number:
        print("Try again!")

print("Correct!")